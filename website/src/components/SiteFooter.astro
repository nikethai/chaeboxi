  <div class="wrap site-footer__row">
    <p>
      <span translate="no">Chaeboxi</span> is GPLv3. Derived from an earlier open-source client. See
      <a href="https://github.com/nikethai/chaeboxi/blob/main/NOTICE" rel="noopener">NOTICE</a>.
    </p>
    <nav aria-label="Footer">
      <a href={`${base}download/`}>Download</a>
      <a href={`${base}#faq`}>FAQ</a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}terms/`}>Terms</a>
      <a href="https://github.com/nikethai/chaeboxi" rel="noopener">GitHub</a>
      <a href="https://github.com/nikethai/chaeboxi/releases" rel="noopener">Releases</a>
    </nav>
  </div>
</footer>
