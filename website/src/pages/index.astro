---
import BaseLayout from '../layouts/BaseLayout.astro'
import IslandNav from '../components/IslandNav.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ProviderMarquee from '../components/ProviderMarquee.astro'
import CapabilityStrip from '../components/CapabilityStrip.astro'
import AudienceGrid from '../components/AudienceGrid.astro'
import DesktopTools from '../components/DesktopTools.astro'
import FirstMinutes from '../components/FirstMinutes.astro'
import CompareTable from '../components/CompareTable.astro'
import FaqList from '../components/FaqList.astro'
import { faqPageNode, softwareApplicationNode } from '../lib/json-ld'
import { HERO_PROOF, HERO_SUB } from '../lib/copy'
import { DEFAULT_DESCRIPTION } from '../lib/site'

const base = import.meta.env.BASE_URL
const download = `${base}download/`
const shell = `${base}screenshot-shell.png`
const thread = `${base}screenshot-thread.png`
---

<BaseLayout title="Chaeboxi — local-first AI copilot" description={DEFAULT_DESCRIPTION} extraJsonLd={[softwareApplicationNode(), faqPageNode()]}>
  <IslandNav slot="nav" />

  <div class="hero-wash" aria-hidden="true"></div>
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__copy">
        <h1>Local-first AI copilot.</h1>
        <p class="hero__sub">{HERO_SUB}</p>
        <p class="hero__proof">{HERO_PROOF}</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={download}>
            Download Desktop
            <span class="btn__icon" aria-hidden="true">↗</span>
          </a>
          <a class="btn btn--ghost" href={`${base}why/`}>Why download</a>
        </div>
      </div>
      <div class="hero__visual reveal">
        <figure class="product-frame">
          <img
            src={shell}
            alt="Chaeboxi desktop studio: dark rail, empty thread, and pinned composer"
            width="1440"
            height="900"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <ProviderMarquee />
  <CapabilityStrip />

  <section class="section wrap">
    <h2>What you get</h2>
    <div class="bento">
      <article class="bento__cell bento__cell--wide panel">
        <div class="bento__pad">
          <p class="meta">On device</p>
          <h3>The thread never leaves this machine</h3>
          <p>Conversations and settings stay on the device you choose. There is no hosted Chaeboxi chat backend to log into.</p>
        </div>
        <img
          src={thread}
          alt="Chaeboxi thread: right-aligned user pill, open assistant prose, studio composer dock"
          width="1440"
          height="900"
          loading="lazy"
        />
      </article>
      <article class="bento__cell bento__cell--side panel">
        <div class="bento__pad">
          <p class="meta">BYOK</p>
          <h3>Keys you already pay for</h3>
          <p>OpenAI, Anthropic, Gemini, Ollama, OpenRouter, and more. No bundled paid AI plan.</p>
        </div>
      </article>
      <article class="bento__cell bento__cell--side panel">
        <div class="bento__pad">
          <p class="meta">16+</p>
          <h3>Providers you already have</h3>
          <p>Same product surface across desktop, web, and mobile. Desktop is the richest shell.</p>
        </div>
      </article>
      <article class="bento__cell bento__cell--full panel">
        <div class="bento__pad">
          <p class="meta">Desktop</p>
          <h3>Agents, MCP, memory, computer use</h3>
          <p>
            Multi-agent rooms, skills, hooks, MCP, knowledge base, browser agent, and computer use ship on
            <strong>desktop</strong>. They are not claimed for web or mobile.
          </p>
        </div>
      </article>
    </div>
  </section>

  <AudienceGrid />
  <DesktopTools />
  <CompareTable />
  <FirstMinutes />
  <FaqList />

  <section class="section wrap cta-band">
    <h2>The desktop app is the product</h2>
    <p>macOS, Windows, and Linux from GitHub Releases. No Chaeboxi account.</p>
    <a class="btn btn--primary" href={download}>
      Download Desktop
      <span class="btn__icon" aria-hidden="true">↗</span>
    </a>
  </section>

  <script>
    const els = document.querySelectorAll('.reveal')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'))
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) entry.target.classList.add('is-in')
          }
        },
        { threshold: 0.2 },
      )
      els.forEach((el) => io.observe(el))
    }
  </script>

  <SiteFooter slot="footer" />
</BaseLayout>
